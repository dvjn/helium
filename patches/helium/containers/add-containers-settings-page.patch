+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/settings/containers_handler.h"
+
+#include <optional>
+#include <string>
+#include <tuple>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/containers/container_color.h"
+#include "chrome/browser/ui/tabs/tab_group_theme.h"
+#include "components/tab_groups/tab_group_color.h"
+#include "content/public/browser/web_contents.h"
+#include "content/public/browser/web_ui.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/color_utils.h"
+
+namespace settings {
+
+namespace {
+
+// Colors in the order they are offered on the page, which is also the order
+// new containers take them in. Matches TabGroupModel::GetColorOrdering().
+constexpr containers::mojom::Color kColors[] = {
+    containers::mojom::Color::kBlue,   containers::mojom::Color::kPurple,
+    containers::mojom::Color::kPink,   containers::mojom::Color::kRed,
+    containers::mojom::Color::kOrange, containers::mojom::Color::kYellow,
+    containers::mojom::Color::kGreen,  containers::mojom::Color::kCyan,
+    containers::mojom::Color::kGrey,
+};
+
+std::optional<containers::mojom::Color> ColorFromValue(
+    const base::Value& value) {
+  if (!value.is_int()) {
+    return std::nullopt;
+  }
+  const auto color = static_cast<containers::mojom::Color>(value.GetInt());
+  if (!containers::mojom::IsKnownEnumValue(color)) {
+    return std::nullopt;
+  }
+  return color;
+}
+
+}  // namespace
+
+ContainersHandler::ContainersHandler(containers::ContainersService* service)
+    : service_(service) {}
+
+ContainersHandler::~ContainersHandler() = default;
+
+void ContainersHandler::RegisterMessages() {
+  web_ui()->RegisterMessageCallback(
+      "getContainersInfo",
+      base::BindRepeating(&ContainersHandler::HandleGetContainersInfo,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "addContainer", base::BindRepeating(&ContainersHandler::HandleAddContainer,
+                                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "updateContainer",
+      base::BindRepeating(&ContainersHandler::HandleUpdateContainer,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "removeContainer",
+      base::BindRepeating(&ContainersHandler::HandleRemoveContainer,
+                          base::Unretained(this)));
+  web_ui()->RegisterMessageCallback(
+      "moveContainer",
+      base::BindRepeating(&ContainersHandler::HandleMoveContainer,
+                          base::Unretained(this)));
+}
+
+void ContainersHandler::OnJavascriptAllowed() {
+  observation_.Observe(service_.get());
+}
+
+void ContainersHandler::OnJavascriptDisallowed() {
+  observation_.Reset();
+}
+
+void ContainersHandler::OnContainersChanged() {
+  FireWebUIListener("containers-changed", GetContainersList());
+}
+
+void ContainersHandler::HandleGetContainersInfo(const base::ListValue& args) {
+  AllowJavascript();
+  ResolveJavascriptCallback(args[0],
+                            base::DictValue()
+                                .Set("containers", GetContainersList())
+                                .Set("colors", GetColorsList()));
+}
+
+void ContainersHandler::HandleAddContainer(const base::ListValue& args) {
+  const std::string* name = args[0].GetIfString();
+  std::optional<containers::mojom::Color> color = ColorFromValue(args[1]);
+  if (name && color) {
+    // The page only sends valid names and colors.
+    std::ignore = service_->AddContainer(
+        containers::mojom::Container::New(std::string(), *name, *color));
+  }
+}
+
+void ContainersHandler::HandleUpdateContainer(const base::ListValue& args) {
+  const std::string* id = args[0].GetIfString();
+  const std::string* name = args[1].GetIfString();
+  std::optional<containers::mojom::Color> color = ColorFromValue(args[2]);
+  if (id && name && color) {
+    service_->UpdateContainer(
+        containers::mojom::Container::New(*id, *name, *color));
+  }
+}
+
+void ContainersHandler::HandleRemoveContainer(const base::ListValue& args) {
+  if (const std::string* id = args[0].GetIfString()) {
+    service_->RemoveContainer(*id);
+  }
+}
+
+void ContainersHandler::HandleMoveContainer(const base::ListValue& args) {
+  const std::string* id = args[0].GetIfString();
+  if (id && args[1].is_int() && args[1].GetInt() >= 0) {
+    service_->MoveContainer(*id, args[1].GetInt());
+  }
+}
+
+base::ListValue ContainersHandler::GetContainersList() const {
+  base::ListValue list;
+  for (const containers::mojom::ContainerPtr& container :
+       service_->GetContainers()) {
+    list.Append(base::DictValue()
+                    .Set("id", container->id)
+                    .Set("name", container->name)
+                    .Set("color", static_cast<int>(container->color)));
+  }
+  return list;
+}
+
+base::ListValue ContainersHandler::GetColorsList() {
+  // The page shows each color as it is drawn in menus, for the current theme.
+  const ui::ColorProvider& color_provider =
+      web_ui()->GetWebContents()->GetColorProvider();
+  const tab_groups::ColorLabelMap& labels =
+      tab_groups::GetTabGroupColorLabelMap();
+  base::ListValue list;
+  for (containers::mojom::Color color : kColors) {
+    const tab_groups::TabGroupColorId tab_group_color =
+        containers::GetTabGroupColorId(color);
+    list.Append(
+        base::DictValue()
+            .Set("value", static_cast<int>(color))
+            .Set("label", labels.at(tab_group_color))
+            .Set("cssColor",
+                 color_utils::SkColorToRgbaString(color_provider.GetColor(
+                     GetTabGroupContextMenuColorId(tab_group_color)))));
+  }
+  return list;
+}
+
+}  // namespace settings
