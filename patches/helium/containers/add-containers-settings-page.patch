+
+import {sendWithPromise} from 'chrome://resources/js/cr.js';
+
+export interface Container {
+  id: string;
+  name: string;
+  color: number;
+}
+
+// A color a container can have, as shown for the current theme.
+export interface ContainerColor {
+  value: number;
