+
+<style include="cr-shared-style settings-shared">
+  /* The page has no section heading to indent under, so line the rows up
+     with the description instead. */
+  .list-frame {
+    padding-inline-start: var(--cr-section-padding);
+  }
+
+  .color-dot {
+    border-radius: 50%;
+    flex-shrink: 0;
+    height: 12px;
+    margin-inline-end: 16px;
+    width: 12px;
+  }
+
+  #colorLabel {
+    margin-top: 16px;
+  }
+
+  /* Room for the selected color's outline, which the dialog would clip. */
+  #colors {
+    display: flex;
+    flex-wrap: wrap;
+    gap: 12px;
+    margin: 4px -4px 0;
+    padding: 4px;
+  }
+
+  .color-option {
+    border: none;
+    border-radius: 50%;
+    cursor: pointer;
+    height: 24px;
+    padding: 0;
+    width: 24px;
+  }
+
+  .color-option[aria-checked='true'] {
+    outline: 2px solid var(--cr-focus-outline-color);
+    outline-offset: 2px;
+  }
+</style>
+
+<div class="cr-row first">
+  <div class="flex cr-padded-text cr-secondary-text">
+    $i18n{containersDescription}
+  </div>
+  <cr-button id="addButton" on-click="onAddClick_">
+    $i18n{add}
+  </cr-button>
+</div>
+
+<div class="list-frame" hidden="[[containers_.length]]">
+  <div class="list-item secondary">$i18n{containersEmpty}</div>
+</div>
+<div class="list-frame vertical-list" role="list"
+    hidden="[[!containers_.length]]">
+  <template is="dom-repeat" items="[[containers_]]">
+    <div class="list-item" role="listitem">
+      <span class="color-dot"
+          style$="background-color: [[getCssColor_(item.color, colors_)]]">
+      </span>
+      <div class="flex text-elide">[[item.name]]</div>
+      <cr-icon-button iron-icon="cr:keyboard-arrow-up"
+          title="$i18n{moveUp}" disabled="[[!index]]"
+          on-click="onMoveUpClick_">
+      </cr-icon-button>
+      <cr-icon-button iron-icon="cr:keyboard-arrow-down"
+          title="$i18n{moveDown}"
+          disabled="[[isLast_(index, containers_.length)]]"
+          on-click="onMoveDownClick_">
+      </cr-icon-button>
+      <cr-icon-button class="icon-edit" title="$i18n{edit}"
+          on-click="onEditClick_">
+      </cr-icon-button>
+      <cr-icon-button class="icon-delete-gray" title="$i18n{remove}"
+          on-click="onRemoveClick_">
+      </cr-icon-button>
+    </div>
+  </template>
+</div>
+
+<template is="dom-if" if="[[showDialog_]]" restamp>
+  <cr-dialog id="dialog" show-on-attach on-close="onDialogClose_">
+    <div slot="title">[[dialogTitle_]]</div>
+    <div slot="body">
+      <cr-input id="nameInput" label="$i18n{containersName}"
+          value="{{dialogName_}}" maxlength="100" autofocus
+          on-keydown="onNameKeydown_">
+      </cr-input>
+      <div id="colorLabel" class="cr-form-field-label">
+        $i18n{containersColor}
+      </div>
+      <div id="colors" role="radiogroup" aria-labelledby="colorLabel">
+        <template is="dom-repeat" items="[[colors_]]">
+          <button class="color-option" role="radio" title="[[item.label]]"
+              aria-label$="[[item.label]]"
+              aria-checked$="[[getColorChecked_(item.value, dialogColor_)]]"
+              style$="background-color: [[item.cssColor]]"
+              on-click="onColorClick_">
+          </button>
+        </template>
+      </div>
+    </div>
+    <div slot="button-container">
+      <cr-button class="cancel-button" on-click="onDialogCancel_">
+        $i18n{cancel}
+      </cr-button>
+      <cr-button id="saveButton" class="action-button"
+          on-click="onDialogSave_"
+          disabled="[[isSaveDisabled_(dialogName_)]]">
+        $i18n{save}
+      </cr-button>
+    </div>
+  </cr-dialog>
+</template>
