+#include "base/values.h"
+#include "chrome/browser/ui/webui/settings/settings_page_ui_handler.h"
+#include "components/containers/core/browser/containers_service.h"
+
+namespace settings {
+
+// Handles the containers settings page: lists, adds, edits, removes and
+// reorders the containers of a profile.
+class ContainersHandler : public SettingsPageUIHandler,
+                          public containers::ContainersService::Observer {
+ public:
+  explicit ContainersHandler(containers::ContainersService* service);
+  ContainersHandler(const ContainersHandler&) = delete;
+  ContainersHandler& operator=(const ContainersHandler&) = delete;
+  ~ContainersHandler() override;
+
+  // SettingsPageUIHandler:
+  void RegisterMessages() override;
+  void OnJavascriptAllowed() override;
+  void OnJavascriptDisallowed() override;
+
+  // containers::ContainersService::Observer:
+  void OnContainersChanged() override;
+
+ private:
+  void HandleGetContainersInfo(const base::ListValue& args);
+  void HandleAddContainer(const base::ListValue& args);
+  void HandleUpdateContainer(const base::ListValue& args);
+  void HandleRemoveContainer(const base::ListValue& args);
+  void HandleMoveContainer(const base::ListValue& args);
+
+  base::ListValue GetContainersList() const;
+  base::ListValue GetColorsList();
+
+  raw_ptr<containers::ContainersService> service_;
+  base::ScopedObservation<containers::ContainersService,
+                          containers::ContainersService::Observer>
+      observation_{this};
+};
+
+}  // namespace settings
+
+#endif  // CHROME_BROWSER_UI_WEBUI_SETTINGS_CONTAINERS_HANDLER_H_
