+export interface ContainersBrowserProxy {
+  getContainersInfo(): Promise<ContainersInfo>;
+  addContainer(name: string, color: number): void;
+  updateContainer(id: string, name: string, color: number): void;
+  removeContainer(id: string): void;
+  moveContainer(id: string, newIndex: number): void;
+}
+
+export class ContainersBrowserProxyImpl implements ContainersBrowserProxy {
+  getContainersInfo(): Promise<ContainersInfo> {
+    return sendWithPromise('getContainersInfo');
+  }
+
+  addContainer(name: string, color: number) {
+    chrome.send('addContainer', [name, color]);
+  }
+
+  updateContainer(id: string, name: string, color: number) {
+    chrome.send('updateContainer', [id, name, color]);
+  }
+
+  removeContainer(id: string) {
+    chrome.send('removeContainer', [id]);
+  }
+
+  moveContainer(id: string, newIndex: number) {
+    chrome.send('moveContainer', [id, newIndex]);
+  }
+
+  static getInstance(): ContainersBrowserProxy {
+    return instance || (instance = new ContainersBrowserProxyImpl());
+  }
+
+  static setInstance(obj: ContainersBrowserProxy) {
+    instance = obj;
+  }
+}
+
+let instance: ContainersBrowserProxy|null = null;
