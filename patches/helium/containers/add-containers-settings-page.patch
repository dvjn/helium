+
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import 'chrome://resources/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/cr_shared_style.css.js';
+import 'chrome://resources/cr_elements/icons.html.js';
+import '../settings_shared.css.js';
+
+import type {CrDialogElement} from 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import {WebUiListenerMixin} from 'chrome://resources/cr_elements/web_ui_listener_mixin.js';
+import type {DomRepeatEvent} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {loadTimeData} from '../i18n_setup.js';
+
+import type {Container, ContainerColor, ContainersBrowserProxy} from './containers_browser_proxy.js';
+import {ContainersBrowserProxyImpl} from './containers_browser_proxy.js';
+import {getTemplate} from './containers_section.html.js';
+
+// The list of containers shown in its own section of the Profiles page.
+const SettingsContainersSectionElementBase = WebUiListenerMixin(PolymerElement);
+
+export class SettingsContainersSectionElement extends
+    SettingsContainersSectionElementBase {
+  static get is() {
+    return 'settings-containers-section';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      containers_: {
+        type: Array,
+        value: () => [],
+      },
+
+      colors_: {
+        type: Array,
+        value: () => [],
+      },
+
+      showDialog_: {
+        type: Boolean,
+        value: false,
+      },
+
+      dialogTitle_: String,
+      dialogName_: String,
+      dialogColor_: Number,
+    };
+  }
+
+  declare private containers_: Container[];
+  declare private colors_: ContainerColor[];
+  declare private showDialog_: boolean;
+  declare private dialogTitle_: string;
+  declare private dialogName_: string;
+  declare private dialogColor_: number;
+
+  private browserProxy_: ContainersBrowserProxy =
+      ContainersBrowserProxyImpl.getInstance();
+
+  // Container the edit dialog is for. Null while adding a container.
+  private activeContainer_: Container|null = null;
+
+  override connectedCallback() {
+    super.connectedCallback();
+
+    this.browserProxy_.getContainersInfo().then(info => {
+      this.containers_ = info.containers;
+      this.colors_ = info.colors;
+    });
+    this.addWebUiListener(
+        'containers-changed',
+        (containers: Container[]) => this.containers_ = containers);
+  }
+
+  private getCssColor_(color: number): string {
+    const match = this.colors_.find(c => c.value === color);
+    return match ? match.cssColor : '';
+  }
+
+  // A boolean binding would set aria-checked to "" instead of "true".
+  private getColorChecked_(color: number, selectedColor: number): string {
+    return color === selectedColor ? 'true' : 'false';
+  }
+
+  private isSaveDisabled_(name: string): boolean {
+    return !name || !name.trim();
+  }
+
+  private getDialog_(): CrDialogElement {
+    return this.shadowRoot!.querySelector<CrDialogElement>('#dialog')!;
+  }
+
+  private openDialog_(title: string, name: string, color: number) {
+    this.dialogTitle_ = title;
+    this.dialogName_ = name;
+    this.dialogColor_ = color;
+    this.showDialog_ = true;
+  }
+
+  private onAddClick_() {
+    this.activeContainer_ = null;
+    // Like a new tab group, suggest the least used color, earliest in the
+    // list on ties.
+    const usage = new Map<number, number>();
+    for (const container of this.containers_) {
+      usage.set(container.color, (usage.get(container.color) ?? 0) + 1);
+    }
+    let color = 0;
+    let minUsage = Infinity;
+    for (const {value} of this.colors_) {
+      const count = usage.get(value) ?? 0;
+      if (count < minUsage) {
+        color = value;
+        minUsage = count;
+      }
+    }
+    this.openDialog_(
+        loadTimeData.getString('containersAddTitle'), '', color);
+  }
+
+  private isLast_(index: number, length: number): boolean {
+    return index === length - 1;
+  }
+
+  private onEditClick_(e: DomRepeatEvent<Container>) {
+    const container = e.model.item;
+    this.activeContainer_ = container;
+    this.openDialog_(
+        loadTimeData.getString('containersEditTitle'), container.name,
+        container.color);
+  }
+
+  private onMoveUpClick_(e: DomRepeatEvent<Container>) {
+    this.browserProxy_.moveContainer(e.model.item.id, e.model.index - 1);
+  }
+
+  private onMoveDownClick_(e: DomRepeatEvent<Container>) {
+    this.browserProxy_.moveContainer(e.model.item.id, e.model.index + 1);
+  }
+
+  private onRemoveClick_(e: DomRepeatEvent<Container>) {
+    this.browserProxy_.removeContainer(e.model.item.id);
+  }
+
+  private onColorClick_(e: DomRepeatEvent<ContainerColor>) {
+    this.dialogColor_ = e.model.item.value;
+  }
+
+  private onNameKeydown_(e: KeyboardEvent) {
+    if (e.key === 'Enter' && !this.isSaveDisabled_(this.dialogName_)) {
+      this.onDialogSave_();
+    }
+  }
+
+  private onDialogCancel_() {
+    this.getDialog_().cancel();
+  }
+
+  private onDialogSave_() {
+    const name = this.dialogName_.trim();
+    if (this.activeContainer_) {
+      this.browserProxy_.updateContainer(
+          this.activeContainer_.id, name, this.dialogColor_);
+    } else {
+      this.browserProxy_.addContainer(name, this.dialogColor_);
+    }
+    this.getDialog_().close();
+  }
+
+  private onDialogClose_() {
+    this.showDialog_ = false;
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-containers-section': SettingsContainersSectionElement;
+  }
+}
+
+customElements.define(
+    SettingsContainersSectionElement.is, SettingsContainersSectionElement);
