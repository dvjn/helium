+#ifndef COMPONENTS_CONTAINERS_CORE_BROWSER_CONTAINERS_SERVICE_H_
+#define COMPONENTS_CONTAINERS_CORE_BROWSER_CONTAINERS_SERVICE_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/memory/raw_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
+#include "base/types/expected.h"
+#include "components/containers/core/mojom/containers.mojom.h"
+#include "components/keyed_service/core/keyed_service.h"
+#include "components/prefs/pref_change_registrar.h"
+
+class PrefService;
+
+namespace containers {
+
+// Owns the list of containers of a profile. The list is stored in profile
+// prefs; this service validates changes to it, notifies observers, and
+// remembers which containers have been used by tabs, so that their tabs and
+// site data can still be found after the container is removed.
+class ContainersService : public KeyedService {
+ public:
+  class Observer : public base::CheckedObserver {
+   public:
+    // Called after the list of containers changes, including changes that did
+    // not go through this service.
+    virtual void OnContainersChanged() {}
+  };
+
+  // `starter_containers` are added the first time the service is created for
+  // a profile, unless the profile already has containers. Their ids must be
+  // empty; new ids are generated for them.
+  ContainersService(PrefService* prefs,
+                    std::vector<mojom::ContainerPtr> starter_containers);
+  ContainersService(const ContainersService&) = delete;
+  ContainersService& operator=(const ContainersService&) = delete;
+  ~ContainersService() override;
+
+  // Returns all containers in the order shown to the user.
+  std::vector<mojom::ContainerPtr> GetContainers() const;
+
+  // Returns nullptr if there is no container with `id`.
+  mojom::ContainerPtr GetContainer(std::string_view id) const;
+
+  // Appends `container` to the list. Its id must be empty. Returns the id
+  // generated for it.
+  base::expected<std::string, mojom::ContainerOperationError> AddContainer(
+      mojom::ContainerPtr container);
+
+  // Replaces the name and color of the container with the same id.
+  std::optional<mojom::ContainerOperationError> UpdateContainer(
+      mojom::ContainerPtr container);
+
+  // Removes the container from the list. This doesn't delete its site data,
+  // and a used container stays in the used record.
+  std::optional<mojom::ContainerOperationError> RemoveContainer(
+      std::string_view id);
+
+  // Moves the container with `id` to `new_index` in the list.
+  std::optional<mojom::ContainerOperationError> MoveContainer(
+      std::string_view id,
+      size_t new_index);
+
+  // Records that a tab has been opened in `container`, along with its current
+  // name and color.
+  void MarkContainerUsed(const mojom::Container& container);
+
+  // Returns the last-known details of every container that has been used,
+  // including containers that have since been removed.
+  std::vector<mojom::ContainerPtr> GetUsedContainers() const;
+
+  // Drops `id` from the used record, once nothing refers to it anymore.
+  void ForgetUsedContainer(std::string_view id);
+
+  void AddObserver(Observer* observer);
+  void RemoveObserver(Observer* observer);
+
+  // KeyedService:
+  void Shutdown() override;
+
+ private:
+  void AddStarterContainersIfNeeded(
+      std::vector<mojom::ContainerPtr> starter_containers);
+  void UpdateUsedContainerIfPresent(const mojom::Container& container);
+  void OnContainersPrefChanged();
+
+  raw_ptr<PrefService> prefs_;
+  PrefChangeRegistrar pref_change_registrar_;
+  base::ObserverList<Observer> observers_;
+};
+
+}  // namespace containers
+
+#endif  // COMPONENTS_CONTAINERS_CORE_BROWSER_CONTAINERS_SERVICE_H_
