+
+namespace containers {
+
+namespace {
+
+std::vector<mojom::ContainerPtr> GetStarterContainers() {
+  std::vector<mojom::ContainerPtr> containers;
+  containers.push_back(mojom::Container::New(
+      std::string(), l10n_util::GetStringUTF8(IDS_CONTAINERS_STARTER_PERSONAL),
+      mojom::Color::kBlue));
+  containers.push_back(mojom::Container::New(
+      std::string(), l10n_util::GetStringUTF8(IDS_CONTAINERS_STARTER_WORK),
+      mojom::Color::kRed));
+  containers.push_back(mojom::Container::New(
+      std::string(), l10n_util::GetStringUTF8(IDS_CONTAINERS_STARTER_BANKING),
+      mojom::Color::kGreen));
+  containers.push_back(mojom::Container::New(
+      std::string(), l10n_util::GetStringUTF8(IDS_CONTAINERS_STARTER_SHOPPING),
+      mojom::Color::kPink));
+  return containers;
+}
+
+}  // namespace
+
+// static
+ContainersService* ContainersServiceFactory::GetForProfile(Profile* profile) {
+  return static_cast<ContainersService*>(
+      GetInstance()->GetServiceForBrowserContext(profile, true));
+}
+
+// static
+ContainersServiceFactory* ContainersServiceFactory::GetInstance() {
+  static base::NoDestructor<ContainersServiceFactory> instance;
+  return instance.get();
+}
+
+ContainersServiceFactory::ContainersServiceFactory()
+    : ProfileKeyedServiceFactory(
+          "ContainersService",
+          ProfileSelections::Builder()
+              .WithRegular(ProfileSelection::kOriginalOnly)
+              .WithGuest(ProfileSelection::kNone)
+              .WithSystem(ProfileSelection::kNone)
+              .WithAshInternals(ProfileSelection::kNone)
+              .Build()) {}
+
+std::unique_ptr<KeyedService>
+ContainersServiceFactory::BuildServiceInstanceForBrowserContext(
+    content::BrowserContext* context) const {
+  if (!base::FeatureList::IsEnabled(features::kHeliumContainers)) {
+    return nullptr;
+  }
+
+  Profile* profile = Profile::FromBrowserContext(context);
+  return std::make_unique<ContainersService>(profile->GetPrefs(),
+                                             GetStarterContainers());
+}
+
+bool ContainersServiceFactory::ServiceIsCreatedWithBrowserContext() const {
+  // Creating the service adds the starter containers, so they exist as soon as
+  // the feature is enabled.
+  return true;
+}
+
+}  // namespace containers
