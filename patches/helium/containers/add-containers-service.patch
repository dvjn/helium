+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/containers/core/browser/prefs.h"
+
+#include <optional>
+#include <set>
+#include <string>
+#include <utility>
+
+#include "components/containers/core/browser/pref_names.h"
+#include "components/containers/core/common/container_id.h"
+#include "components/pref_registry/pref_registry_syncable.h"
+#include "components/prefs/pref_service.h"
+
+namespace containers {
+
+namespace {
+
+constexpr char kIdKey[] = "id";
+constexpr char kNameKey[] = "name";
+constexpr char kColorKey[] = "color";
+
+}  // namespace
+
+void RegisterProfilePrefs(user_prefs::PrefRegistrySyncable* registry) {
+  registry->RegisterListPref(prefs::kContainersList);
+  registry->RegisterDictionaryPref(prefs::kUsedContainers);
+  registry->RegisterBooleanPref(prefs::kStarterContainersAdded, false);
+}
+
+mojom::ContainerPtr ContainerFromValue(const base::DictValue& dict) {
+  const std::string* id = dict.FindString(kIdKey);
+  const std::string* name = dict.FindString(kNameKey);
+  if (!id || !IsValidContainerId(*id) || !name || name->empty()) {
+    return nullptr;
+  }
+
+  auto color = mojom::Color::kGrey;
+  if (std::optional<int> value = dict.FindInt(kColorKey);
+      value && mojom::IsKnownEnumValue(static_cast<mojom::Color>(*value))) {
+    color = static_cast<mojom::Color>(*value);
+  }
+
+  return mojom::Container::New(*id, *name, color);
+}
+
+base::DictValue ContainerToValue(const mojom::Container& container) {
+  return base::DictValue()
+      .Set(kIdKey, container.id)
+      .Set(kNameKey, container.name)
+      .Set(kColorKey, static_cast<int>(container.color));
+}
+
+std::vector<mojom::ContainerPtr> GetContainersFromPrefs(
+    const PrefService& prefs) {
+  std::vector<mojom::ContainerPtr> containers;
+  std::set<std::string> seen_ids;
+  for (const base::Value& value : prefs.GetList(prefs::kContainersList)) {
+    if (!value.is_dict()) {
+      continue;
+    }
+
+    mojom::ContainerPtr container = ContainerFromValue(value.GetDict());
+    if (!container || !seen_ids.insert(container->id).second) {
+      continue;
+    }
+
+    containers.push_back(std::move(container));
+  }
+  return containers;
+}
+
+void SetContainersToPrefs(const std::vector<mojom::ContainerPtr>& containers,
+                          PrefService& prefs) {
+  base::ListValue list;
+  for (const mojom::ContainerPtr& container : containers) {
+    list.Append(ContainerToValue(*container));
+  }
+  prefs.SetList(prefs::kContainersList, std::move(list));
+}
+
+}  // namespace containers
