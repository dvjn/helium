+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/containers/core/browser/containers_service.h"
+
+#include <algorithm>
+#include <iterator>
+#include <utility>
+
+#include "base/check.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_util.h"
+#include "components/containers/core/browser/pref_names.h"
+#include "components/containers/core/browser/prefs.h"
+#include "components/containers/core/common/container_id.h"
+#include "components/prefs/pref_service.h"
+#include "components/prefs/scoped_user_pref_update.h"
+
+namespace containers {
+
+namespace {
+
+// Trims `name` in place and returns whether anything is left.
+bool NormalizeContainerName(std::string& name) {
+  name = std::string(base::TrimWhitespaceASCII(name, base::TRIM_ALL));
+  return !name.empty();
+}
+
+auto FindContainer(std::vector<mojom::ContainerPtr>& containers,
+                   std::string_view id) {
+  return std::ranges::find_if(
+      containers, [id](const mojom::ContainerPtr& c) { return c->id == id; });
+}
+
+}  // namespace
+
+ContainersService::ContainersService(
+    PrefService* prefs,
+    std::vector<mojom::ContainerPtr> starter_containers)
+    : prefs_(prefs) {
+  CHECK(prefs_);
+  AddStarterContainersIfNeeded(std::move(starter_containers));
+
+  pref_change_registrar_.Init(prefs_);
+  pref_change_registrar_.Add(
+      prefs::kContainersList,
+      base::BindRepeating(&ContainersService::OnContainersPrefChanged,
+                          base::Unretained(this)));
+}
+
+ContainersService::~ContainersService() = default;
+
+std::vector<mojom::ContainerPtr> ContainersService::GetContainers() const {
+  return GetContainersFromPrefs(*prefs_);
+}
+
+mojom::ContainerPtr ContainersService::GetContainer(std::string_view id) const {
+  std::vector<mojom::ContainerPtr> containers = GetContainers();
+  auto it = FindContainer(containers, id);
+  if (it == containers.end()) {
+    return nullptr;
+  }
+  return std::move(*it);
+}
+
+base::expected<std::string, mojom::ContainerOperationError>
+ContainersService::AddContainer(mojom::ContainerPtr container) {
+  if (!container->id.empty()) {
+    return base::unexpected(mojom::ContainerOperationError::kIdShouldBeEmpty);
+  }
+  if (!NormalizeContainerName(container->name)) {
+    return base::unexpected(mojom::ContainerOperationError::kInvalidName);
+  }
+
+  std::vector<mojom::ContainerPtr> containers = GetContainers();
+  container->id = GenerateContainerId();
+  std::string id = container->id;
+  containers.push_back(std::move(container));
+  SetContainersToPrefs(containers, *prefs_);
+  return id;
+}
+
+std::optional<mojom::ContainerOperationError>
+ContainersService::UpdateContainer(mojom::ContainerPtr container) {
+  if (container->id.empty()) {
+    return mojom::ContainerOperationError::kIdShouldBeSet;
+  }
+  if (!NormalizeContainerName(container->name)) {
+    return mojom::ContainerOperationError::kInvalidName;
+  }
+
+  std::vector<mojom::ContainerPtr> containers = GetContainers();
+  auto it = FindContainer(containers, container->id);
+  if (it == containers.end()) {
+    return mojom::ContainerOperationError::kNotFound;
+  }
+
+  UpdateUsedContainerIfPresent(*container);
+  *it = std::move(container);
+  SetContainersToPrefs(containers, *prefs_);
+  return std::nullopt;
+}
+
+std::optional<mojom::ContainerOperationError>
+ContainersService::RemoveContainer(std::string_view id) {
+  if (id.empty()) {
+    return mojom::ContainerOperationError::kIdShouldBeSet;
+  }
+
+  std::vector<mojom::ContainerPtr> containers = GetContainers();
+  auto it = FindContainer(containers, id);
+  if (it == containers.end()) {
+    return mojom::ContainerOperationError::kNotFound;
+  }
+
+  containers.erase(it);
+  SetContainersToPrefs(containers, *prefs_);
+  return std::nullopt;
+}
+
+std::optional<mojom::ContainerOperationError> ContainersService::MoveContainer(
+    std::string_view id,
+    size_t new_index) {
+  if (id.empty()) {
+    return mojom::ContainerOperationError::kIdShouldBeSet;
+  }
+
+  std::vector<mojom::ContainerPtr> containers = GetContainers();
+  auto it = FindContainer(containers, id);
+  if (it == containers.end()) {
+    return mojom::ContainerOperationError::kNotFound;
+  }
+  if (new_index >= containers.size()) {
+    return mojom::ContainerOperationError::kInvalidIndex;
+  }
+
+  const size_t old_index = std::distance(containers.begin(), it);
+  if (old_index == new_index) {
+    return std::nullopt;
+  }
+
+  mojom::ContainerPtr container = std::move(*it);
+  containers.erase(it);
+  containers.insert(containers.begin() + new_index, std::move(container));
+  SetContainersToPrefs(containers, *prefs_);
+  return std::nullopt;
+}
+
+void ContainersService::MarkContainerUsed(const mojom::Container& container) {
+  CHECK(IsValidContainerId(container.id));
+  ScopedDictPrefUpdate update(prefs_, prefs::kUsedContainers);
+  update->Set(container.id, ContainerToValue(container));
+}
+
+std::vector<mojom::ContainerPtr> ContainersService::GetUsedContainers() const {
+  std::vector<mojom::ContainerPtr> containers;
+  for (const auto [id, value] : prefs_->GetDict(prefs::kUsedContainers)) {
+    if (!value.is_dict()) {
+      continue;
+    }
+
+    mojom::ContainerPtr container = ContainerFromValue(value.GetDict());
+    if (container && container->id == id) {
+      containers.push_back(std::move(container));
+    }
+  }
+  return containers;
+}
+
+void ContainersService::ForgetUsedContainer(std::string_view id) {
+  ScopedDictPrefUpdate update(prefs_, prefs::kUsedContainers);
+  update->Remove(id);
+}
+
+void ContainersService::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void ContainersService::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+void ContainersService::Shutdown() {
+  pref_change_registrar_.RemoveAll();
+}
+
+void ContainersService::AddStarterContainersIfNeeded(
+    std::vector<mojom::ContainerPtr> starter_containers) {
+  if (prefs_->GetBoolean(prefs::kStarterContainersAdded)) {
+    return;
+  }
+  prefs_->SetBoolean(prefs::kStarterContainersAdded, true);
+
+  if (!GetContainers().empty()) {
+    return;
+  }
+
+  std::vector<mojom::ContainerPtr> containers;
+  for (mojom::ContainerPtr& container : starter_containers) {
+    CHECK(container->id.empty());
+    if (!NormalizeContainerName(container->name)) {
+      continue;
+    }
+    container->id = GenerateContainerId();
+    containers.push_back(std::move(container));
+  }
+  SetContainersToPrefs(containers, *prefs_);
+}
+
+void ContainersService::UpdateUsedContainerIfPresent(
+    const mojom::Container& container) {
+  if (!prefs_->GetDict(prefs::kUsedContainers).contains(container.id)) {
+    return;
+  }
+  MarkContainerUsed(container);
+}
+
+void ContainersService::OnContainersPrefChanged() {
+  observers_.Notify(&Observer::OnContainersChanged);
+}
+
+}  // namespace containers
