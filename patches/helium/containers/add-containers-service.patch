+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+module containers.mojom;
+
+// Colour used for a container's tab indicator, drawn with the matching tab
+// group colour. The values are persisted in profile prefs, so existing entries
+// must never be renumbered.
+enum Color {
+  kBlue = 0,
+  kCyan = 1,
+  kGreen = 2,
+  kYellow = 3,
+  kOrange = 4,
+  kRed = 5,
+  kPink = 6,
+  kPurple = 7,
+  kGrey = 8,
+};
+
+// A user-visible container: a named set of tabs that share a cookie and site
+// storage jar, separate from the rest of the profile.
+struct Container {
+  // Stable identifier generated by the browser, also used as the name of the
+  // container's StoragePartition. Empty for a container that has not been
+  // added yet.
+  string id;
+
+  // User-visible name.
+  string name;
+
+  Color color;
+};
+
+// Error returned by an operation on the list of containers.
+enum ContainerOperationError {
+  kIdShouldBeEmpty,
+  kIdShouldBeSet,
+  kInvalidName,
+  kNotFound,
+  kInvalidIndex,
+};
