+#include "chrome/browser/containers/container_color.h"
+
+#include "base/notreached.h"
+
+namespace containers {
+
+tab_groups::TabGroupColorId GetTabGroupColorId(mojom::Color color) {
+  switch (color) {
+    case mojom::Color::kBlue:
+      return tab_groups::TabGroupColorId::kBlue;
+    case mojom::Color::kCyan:
+      return tab_groups::TabGroupColorId::kCyan;
+    case mojom::Color::kGreen:
+      return tab_groups::TabGroupColorId::kGreen;
+    case mojom::Color::kYellow:
+      return tab_groups::TabGroupColorId::kYellow;
+    case mojom::Color::kOrange:
+      return tab_groups::TabGroupColorId::kOrange;
+    case mojom::Color::kRed:
+      return tab_groups::TabGroupColorId::kRed;
+    case mojom::Color::kPink:
+      return tab_groups::TabGroupColorId::kPink;
+    case mojom::Color::kPurple:
+      return tab_groups::TabGroupColorId::kPurple;
+    case mojom::Color::kGrey:
+      return tab_groups::TabGroupColorId::kGrey;
+  }
+  NOTREACHED();
+}
+
+}  // namespace containers
