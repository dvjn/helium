+#include "chrome/browser/ui/tabs/tab_group_theme.h"
+#include "chrome/browser/ui/tabs/tab_style.h"
+#include "chrome/browser/ui/views/tabs/shared/tab_strip_types.h"
+#include "chrome/browser/ui/views/tabs/tab_style_views.h"
+#include "components/tabs/public/tab_interface.h"
+#include "third_party/skia/include/core/SkPath.h"
+#include "ui/color/color_provider.h"
+#include "ui/gfx/canvas.h"
+#include "ui/gfx/geometry/rect.h"
+#include "ui/gfx/geometry/rect_conversions.h"
+#include "ui/gfx/geometry/skia_conversions.h"
+#include "ui/gfx/scoped_canvas.h"
+#include "ui/views/view.h"
+#include "ui/views/widget/widget.h"
+
+namespace {
+
+constexpr int kIndicatorThickness = 2;
+
+}  // namespace
+
+void PaintContainerIndicator(gfx::Canvas* canvas,
+                             const views::View& tab_view,
+                             const TabStyleViews& tab_style,
+                             const tabs::TabInterface* tab,
+                             TabStripOrientation orientation) {
+  if (!tab || !tab->GetContents()) {
+    return;
+  }
+
+  std::optional<containers::mojom::Color> color =
+      containers::GetContainerColorForWebContents(tab->GetContents());
+  if (!color) {
+    return;
+  }
+
+  const SkPath shape =
+      tab_style.GetPath(TabStyle::PathType::kHighlight, /*scale=*/1.0f,
+                        {.render_units = TabStyle::RenderUnits::kDips});
+  const gfx::Rect bounds =
+      gfx::ToEnclosingRect(gfx::SkRectToRectF(shape.getBounds()));
+  gfx::Rect line = bounds;
+  if (orientation == TabStripOrientation::kVertical) {
+    line.set_width(kIndicatorThickness);
+    if (base::i18n::IsRTL()) {
+      line.set_x(bounds.right() - kIndicatorThickness);
+    }
+  } else {
+    line.set_height(kIndicatorThickness);
+  }
+
+  gfx::ScopedCanvas scoped_canvas(canvas);
+  canvas->ClipPath(shape, /*do_anti_alias=*/true);
+  canvas->FillRect(line, tab_view.GetColorProvider()->GetColor(
+                             GetTabGroupTabStripColorId(
+                                 containers::GetTabGroupColorId(*color),
+                                 tab_view.GetWidget()->ShouldPaintAsActive())));
+}
