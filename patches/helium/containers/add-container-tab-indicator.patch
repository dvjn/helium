+std::optional<mojom::Color> GetContainerColorForWebContents(
+    content::WebContents* web_contents) {
+  std::optional<std::string> container_id =
+      GetContainerIdForWebContents(web_contents);
+  if (!container_id) {
+    return std::nullopt;
+  }
+
+  ContainersService* service = ContainersServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(web_contents->GetBrowserContext()));
+  if (!service) {
+    return std::nullopt;
+  }
+
+  if (mojom::ContainerPtr container = service->GetContainer(*container_id)) {
+    return container->color;
+  }
+  for (const mojom::ContainerPtr& container : service->GetUsedContainers()) {
+    if (container->id == *container_id) {
+      return container->color;
+    }
+  }
+  return mojom::Color::kGrey;
+}
+
 }  // namespace containers
