+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef COMPONENTS_CONTAINERS_CONTENT_BROWSER_STORAGE_PARTITION_UTILS_H_
+#define COMPONENTS_CONTAINERS_CONTENT_BROWSER_STORAGE_PARTITION_UTILS_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "content/public/browser/storage_partition_config.h"
+
+namespace content {
+class BrowserContext;
+class WebContents;
+}  // namespace content
+
+namespace containers {
+
+// Returns the config of the StoragePartition that holds the site data of the
+// container with `container_id`, which must be a valid container id.
+content::StoragePartitionConfig GetStoragePartitionConfigForContainer(
+    content::BrowserContext* browser_context,
+    std::string_view container_id);
+
+// Returns the container id if `config` belongs to a container.
+std::optional<std::string> GetContainerIdFromStoragePartitionConfig(
+    const content::StoragePartitionConfig& config);
+
+// Returns the id of the container `web_contents` belongs to, if any. This
+// reads the StoragePartition of its SiteInstance, and falls back to the id
+// stored by SetContainerIdForWebContents() if the partition doesn't belong to
+// a container, for example in a discarded tab.
+std::optional<std::string> GetContainerIdForWebContents(
+    content::WebContents* web_contents);
+
+// Remembers that `web_contents` belongs to the container with `container_id`.
+void SetContainerIdForWebContents(content::WebContents* web_contents,
+                                  std::string_view container_id);
+
+}  // namespace containers
+
+#endif  // COMPONENTS_CONTAINERS_CONTENT_BROWSER_STORAGE_PARTITION_UTILS_H_
