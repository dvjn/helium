+std::optional<content::StoragePartitionConfig>
+GetContainerStoragePartitionToInherit(content::SiteInstance* source) {
+  if (!base::FeatureList::IsEnabled(features::kHeliumContainers)) {
+    return std::nullopt;
+  }
+
+  content::StoragePartition* partition =
+      source->GetBrowserContext()->GetStoragePartition(source,
+                                                       /*can_create=*/false);
+  if (!partition ||
+      !GetContainerIdFromStoragePartitionConfig(partition->GetConfig())) {
+    return std::nullopt;
+  }
+  return partition->GetConfig();
+}
