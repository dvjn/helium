+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/containers/containers_tab_util.h"
+
+#include <string>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/feature_list.h"
+#include "base/logging.h"
+#include "base/strings/string_util.h"
+#include "chrome/browser/containers/containers_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "components/containers/content/browser/storage_partition_utils.h"
+#include "components/containers/core/browser/containers_service.h"
+#include "components/containers/core/common/features.h"
+#include "content/public/browser/browser_context.h"
+#include "content/public/browser/storage_partition.h"
+#include "content/public/browser/web_contents.h"
+
+namespace containers {
+
+std::optional<content::StoragePartitionConfig> FindContainerStoragePartition(
+    Profile* profile,
+    std::string_view id_or_name) {
+  ContainersService* service = ContainersServiceFactory::GetForProfile(profile);
+  if (!service) {
+    return std::nullopt;
+  }
+
+  mojom::ContainerPtr container = service->GetContainer(id_or_name);
+  if (!container) {
+    for (mojom::ContainerPtr& candidate : service->GetContainers()) {
+      if (base::EqualsCaseInsensitiveASCII(candidate->name, id_or_name)) {
+        container = std::move(candidate);
+        break;
+      }
+    }
+  }
+  if (!container) {
+    return std::nullopt;
+  }
+
+  return GetStoragePartitionConfigForContainer(profile, container->id);
+}
+
+std::optional<content::StoragePartitionConfig>
+GetStoragePartitionConfigForCommandLine(Profile* profile,
+                                        const base::CommandLine& command_line) {
+  if (!command_line.HasSwitch(kContainerSwitch)) {
+    return std::nullopt;
+  }
+
+  const std::string value = command_line.GetSwitchValueUTF8(kContainerSwitch);
+  std::optional<content::StoragePartitionConfig> config =
+      FindContainerStoragePartition(profile, value);
+  if (!config) {
+    LOG(WARNING) << "Ignoring --" << kContainerSwitch << "=" << value
+                 << ": no such container";
+  }
+  return config;
+}
+
+void OnTabContentsCreated(content::WebContents* contents) {
+  if (!base::FeatureList::IsEnabled(features::kHeliumContainers)) {
+    return;
+  }
+
+  const content::StoragePartitionConfig& config =
+      contents->GetBrowserContext()
+          ->GetStoragePartition(contents->GetSiteInstance())
+          ->GetConfig();
+  std::optional<std::string> container_id =
+      GetContainerIdFromStoragePartitionConfig(config);
+  if (!container_id) {
+    return;
+  }
+
+  SetContainerIdForWebContents(contents, *container_id);
+
+  ContainersService* service = ContainersServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(contents->GetBrowserContext()));
+  if (!service) {
+    return;
+  }
+  if (mojom::ContainerPtr container = service->GetContainer(*container_id)) {
+    service->MarkContainerUsed(*container);
+  }
+}
+
+}  // namespace containers
