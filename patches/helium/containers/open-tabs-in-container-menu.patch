+namespace {
+
+// Opens the pages of `tabs` in new tabs in the container with `container_id`,
+// or outside any container if it's nullopt.
+void OpenTabsInContainer(const std::vector<tabs::TabHandle>& tabs,
+                         const std::optional<std::string>& container_id) {
+  for (const tabs::TabHandle& handle : tabs) {
+    tabs::TabInterface* tab = handle.Get();
+    if (!tab) {
+      continue;
+    }
+    containers::OpenURLInContainer(
+        tab->GetBrowserWindowInterface(),
+        tab->GetContents()->GetLastCommittedURL(),
+        /*initiator_origin=*/std::nullopt, container_id,
+        tabs.size() == 1 ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+                         : WindowOpenDisposition::NEW_BACKGROUND_TAB);
+  }
+}
+
+}  // namespace
