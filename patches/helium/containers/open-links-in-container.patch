+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/containers/open_in_container.h"
+
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "components/containers/content/browser/storage_partition_utils.h"
+
+namespace containers {
+
+void OpenURLInContainer(BrowserWindowInterface* browser,
+                        const GURL& url,
+                        const std::optional<url::Origin>& initiator_origin,
+                        const std::optional<std::string>& container_id,
+                        WindowOpenDisposition disposition) {
+  NavigateParams params(browser, url, ui::PAGE_TRANSITION_LINK);
+  params.initiator_origin = initiator_origin;
+  params.disposition = disposition;
+  if (container_id) {
+    params.storage_partition_config = GetStoragePartitionConfigForContainer(
+        browser->GetProfile(), *container_id);
+  }
+  Navigate(&params);
+}
+
+}  // namespace containers
