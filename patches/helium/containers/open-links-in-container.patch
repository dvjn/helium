+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/containers/containers_menu_model.h"
+
+#include <utility>
+
+#include "base/check_op.h"
+#include "base/memory/ptr_util.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/app/vector_icons/vector_icons.h"
+#include "chrome/browser/containers/container_color.h"
+#include "chrome/browser/containers/containers_service_factory.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/ui/tabs/tab_group_theme.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/containers/content/browser/storage_partition_utils.h"
+#include "components/containers/core/browser/containers_service.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "ui/base/models/image_model.h"
+
+namespace containers {
+
+namespace {
+
+// Items are numbered from here, in a range no other command uses, so the
+// submenu can be added to any menu.
+constexpr int kFirstCommandId = kOpenInContainerCommandId + 1;
+constexpr size_t kMaxItems = 99;
+
+constexpr int kIconSize = 14;
+
+}  // namespace
+
+// static
+std::unique_ptr<ContainersMenuModel> ContainersMenuModel::Create(
+    content::WebContents* source,
+    Callback callback) {
+  ContainersService* service = ContainersServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(source->GetBrowserContext()));
+  if (!service) {
+    return nullptr;
+  }
+
+  const std::optional<std::string> current_container_id =
+      GetContainerIdForWebContents(source);
+  auto model = base::WrapUnique(new ContainersMenuModel(std::move(callback)));
+  for (const mojom::ContainerPtr& container : service->GetContainers()) {
+    if (container->id == current_container_id) {
+      continue;
+    }
+    model->AddContainerItem(
+        container->id, base::UTF8ToUTF16(container->name),
+        ui::ImageModel::FromVectorIcon(
+            kCircleFilledIcon,
+            GetTabGroupContextMenuColorId(GetTabGroupColorId(container->color)),
+            kIconSize));
+  }
+  if (current_container_id) {
+    if (model->GetItemCount() > 0) {
+      model->AddSeparator(ui::NORMAL_SEPARATOR);
+    }
+    model->AddContainerItem(
+        std::nullopt,
+        l10n_util::GetStringUTF16(IDS_CONTAINERS_MENU_NO_CONTAINER),
+        ui::ImageModel());
+  }
+
+  if (model->container_ids_.empty()) {
+    return nullptr;
+  }
+  return model;
+}
+
+ContainersMenuModel::ContainersMenuModel(Callback callback)
+    : ui::SimpleMenuModel(this), callback_(std::move(callback)) {}
+
+ContainersMenuModel::~ContainersMenuModel() = default;
+
+void ContainersMenuModel::ExecuteCommand(int command_id, int event_flags) {
+  const size_t index = command_id - kFirstCommandId;
+  CHECK_LT(index, container_ids_.size());
+  callback_.Run(container_ids_[index]);
+}
+
+void ContainersMenuModel::AddContainerItem(
+    std::optional<std::string> container_id,
+    const std::u16string& label,
+    const ui::ImageModel& icon) {
+  if (container_ids_.size() >= kMaxItems) {
+    return;
+  }
+
+  const int command_id = kFirstCommandId + container_ids_.size();
+  container_ids_.push_back(std::move(container_id));
+  if (icon.IsEmpty()) {
+    AddItem(command_id, label);
+  } else {
+    AddItemWithIcon(command_id, label, icon);
+  }
+}
+
+}  // namespace containers
