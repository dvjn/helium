+
+#ifndef CHROME_BROWSER_UI_CONTAINERS_OPEN_IN_CONTAINER_H_
+#define CHROME_BROWSER_UI_CONTAINERS_OPEN_IN_CONTAINER_H_
+
+#include <optional>
+#include <string>
+
+#include "ui/base/window_open_disposition.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+
+class BrowserWindowInterface;
+
+namespace containers {
+
+// Opens `url` in a new tab in `browser`, in the container with `container_id`,
+// or outside any container if it's nullopt. The container doesn't share site
+// data with the page `url` came from, so nothing is carried over from it
+// except `initiator_origin`, and no referrer is sent.
+void OpenURLInContainer(BrowserWindowInterface* browser,
+                        const GURL& url,
+                        const std::optional<url::Origin>& initiator_origin,
+                        const std::optional<std::string>& container_id,
+                        WindowOpenDisposition disposition);
+
+}  // namespace containers
+
+#endif  // CHROME_BROWSER_UI_CONTAINERS_OPEN_IN_CONTAINER_H_
