+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/containers/core/common/container_id.h"
+
+#include <algorithm>
+
+#include "base/strings/string_util.h"
+#include "base/uuid.h"
+
+namespace containers {
+
+bool IsValidContainerId(std::string_view id) {
+  if (id.empty() || id.size() > kMaxContainerIdLength) {
+    return false;
+  }
+
+  return std::ranges::all_of(id, [](char c) {
+    return base::IsAsciiAlphaNumeric(c) || c == '-';
+  });
+}
+
+std::string GenerateContainerId() {
+  return base::Uuid::GenerateRandomV4().AsLowercaseString();
+}
+
+}  // namespace containers
