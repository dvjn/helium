+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#ifndef COMPONENTS_CONTAINERS_CORE_COMMON_CONTAINER_ID_H_
+#define COMPONENTS_CONTAINERS_CORE_COMMON_CONTAINER_ID_H_
+
+#include <string>
+#include <string_view>
+
+namespace containers {
+
+// StoragePartition domain that holds the site data of all containers. The
+// container id is used as the partition name.
+inline constexpr char kContainersStoragePartitionDomain[] = "containers";
+
+// Container ids are also StoragePartition names, so they are limited to
+// characters that are safe in a partition key.
+inline constexpr size_t kMaxContainerIdLength = 64;
+
+// Returns true if `id` is non-empty, at most kMaxContainerIdLength long and
+// only consists of [A-Za-z0-9-].
+bool IsValidContainerId(std::string_view id);
+
+// Returns a new random container id.
+std::string GenerateContainerId();
+
+}  // namespace containers
+
+#endif  // COMPONENTS_CONTAINERS_CORE_COMMON_CONTAINER_ID_H_
