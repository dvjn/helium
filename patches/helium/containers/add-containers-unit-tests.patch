+namespace containers {
+
+class ContainersPrefsTest : public testing::Test {
+ protected:
+  void SetUp() override { RegisterProfilePrefs(prefs_.registry()); }
+
+  sync_preferences::TestingPrefServiceSyncable prefs_;
+};
+
+TEST_F(ContainersPrefsTest, EmptyByDefault) {
+  EXPECT_TRUE(GetContainersFromPrefs(prefs_).empty());
+}
+
+TEST_F(ContainersPrefsTest, RoundTrip) {
+  std::vector<mojom::ContainerPtr> containers;
+  containers.push_back(
+      mojom::Container::New("container-1", "Work", mojom::Color::kRed));
+  containers.push_back(
+      mojom::Container::New("container-2", "Personal", mojom::Color::kBlue));
+
+  SetContainersToPrefs(containers, prefs_);
+
+  std::vector<mojom::ContainerPtr> result = GetContainersFromPrefs(prefs_);
+  ASSERT_EQ(2u, result.size());
+  EXPECT_EQ(containers[0], result[0]);
+  EXPECT_EQ(containers[1], result[1]);
+}
+
+TEST_F(ContainersPrefsTest, SkipsInvalidAndDuplicateEntries) {
+  base::ListValue list;
+  list.Append(42);
+  list.Append(base::DictValue().Set("id", "missing-name"));
+  list.Append(base::DictValue().Set("name", "Missing id"));
+  list.Append(base::DictValue().Set("id", "bad id").Set("name", "Bad id"));
+  list.Append(base::DictValue().Set("id", "ok").Set("name", ""));
+  list.Append(base::DictValue().Set("id", "ok").Set("name", "First"));
+  list.Append(base::DictValue().Set("id", "ok").Set("name", "Duplicate"));
+  prefs_.SetList(prefs::kContainersList, std::move(list));
+
+  std::vector<mojom::ContainerPtr> result = GetContainersFromPrefs(prefs_);
+  ASSERT_EQ(1u, result.size());
+  EXPECT_EQ("ok", result[0]->id);
+  EXPECT_EQ("First", result[0]->name);
+}
+
+TEST_F(ContainersPrefsTest, UnknownColorFallsBackToDefault) {
+  mojom::ContainerPtr container = ContainerFromValue(base::DictValue()
+                                                         .Set("id", "id")
+                                                         .Set("name", "Name")
+                                                         .Set("color", -1));
+  ASSERT_TRUE(container);
+  EXPECT_EQ(mojom::Color::kGrey, container->color);
+}
+
