+using ContainersStoragePartitionUtilsTest = content::RenderViewHostTestHarness;
+
+TEST_F(ContainersStoragePartitionUtilsTest, ConfigRoundTrip) {
+  content::StoragePartitionConfig config =
+      GetStoragePartitionConfigForContainer(browser_context(), "work");
+  EXPECT_EQ(kContainersStoragePartitionDomain, config.partition_domain());
+  EXPECT_EQ("work", config.partition_name());
+  EXPECT_FALSE(config.in_memory());
+  EXPECT_EQ("work", GetContainerIdFromStoragePartitionConfig(config));
+}
+
+TEST_F(ContainersStoragePartitionUtilsTest, OtherPartitionsAreNotContainers) {
+  EXPECT_FALSE(GetContainerIdFromStoragePartitionConfig(
+      content::StoragePartitionConfig::CreateDefault(browser_context())));
+  EXPECT_FALSE(GetContainerIdFromStoragePartitionConfig(
+      content::StoragePartitionConfig::Create(browser_context(), "webview",
+                                              "work", /*in_memory=*/false)));
+}
+
+TEST_F(ContainersStoragePartitionUtilsTest, DefaultWebContents) {
+  EXPECT_FALSE(GetContainerIdForWebContents(web_contents()));
+}
+
+TEST_F(ContainersStoragePartitionUtilsTest, WebContentsInContainer) {
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContentsTester::CreateTestWebContents(
+          browser_context(),
+          content::SiteInstance::CreateForFixedStoragePartition(
+              browser_context(), GURL("https://example.com"),
+              GetStoragePartitionConfigForContainer(browser_context(),
+                                                    "work")));
+  EXPECT_EQ("work", GetContainerIdForWebContents(contents.get()));
+}
+
+TEST_F(ContainersStoragePartitionUtilsTest, FallsBackToStoredId) {
+  SetContainerIdForWebContents(web_contents(), "personal");
+  EXPECT_EQ("personal", GetContainerIdForWebContents(web_contents()));
+}
+
+TEST_F(ContainersStoragePartitionUtilsTest, PartitionTakesPrecedence) {
+  std::unique_ptr<content::WebContents> contents =
+      content::WebContentsTester::CreateTestWebContents(
+          browser_context(),
+          content::SiteInstance::CreateForFixedStoragePartition(
+              browser_context(), GURL("https://example.com"),
+              GetStoragePartitionConfigForContainer(browser_context(),
+                                                    "work")));
+  SetContainerIdForWebContents(contents.get(), "stale");
+  EXPECT_EQ("work", GetContainerIdForWebContents(contents.get()));
+}
