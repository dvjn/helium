+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/containers/core/browser/containers_service.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/scoped_observation.h"
+#include "base/values.h"
+#include "components/containers/core/browser/pref_names.h"
+#include "components/containers/core/browser/prefs.h"
+#include "components/containers/core/common/container_id.h"
+#include "components/sync_preferences/testing_pref_service_syncable.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace containers {
+
+namespace {
+
+mojom::ContainerPtr MakeContainer(std::string name,
+                                  std::string id = std::string()) {
+  return mojom::Container::New(std::move(id), std::move(name),
+                               mojom::Color::kBlue);
+}
+
+std::vector<std::string> GetNames(
+    const std::vector<mojom::ContainerPtr>& containers) {
+  std::vector<std::string> names;
+  for (const mojom::ContainerPtr& container : containers) {
+    names.push_back(container->name);
+  }
+  return names;
+}
+
+class TestObserver : public ContainersService::Observer {
+ public:
+  void OnContainersChanged() override { ++change_count_; }
+
+  int change_count() const { return change_count_; }
+
+ private:
+  int change_count_ = 0;
+};
+
+}  // namespace
+
+class ContainersServiceTest : public testing::Test {
+ protected:
+  void SetUp() override { RegisterProfilePrefs(prefs_.registry()); }
+
+  void TearDown() override {
+    if (service_) {
+      service_->Shutdown();
+    }
+  }
+
+  ContainersService* CreateService(
+      std::vector<mojom::ContainerPtr> starter_containers = {}) {
+    if (service_) {
+      service_->Shutdown();
+    }
+    service_ = std::make_unique<ContainersService>(
+        &prefs_, std::move(starter_containers));
+    return service_.get();
+  }
+
+  // Adds containers with the given names and returns their ids.
+  std::vector<std::string> AddContainers(
+      const std::vector<std::string>& names) {
+    std::vector<std::string> ids;
+    for (const std::string& name : names) {
+      auto id = service_->AddContainer(MakeContainer(name));
+      EXPECT_TRUE(id.has_value());
+      ids.push_back(id.value());
+    }
+    return ids;
+  }
+
+  sync_preferences::TestingPrefServiceSyncable prefs_;
+  std::unique_ptr<ContainersService> service_;
+};
+
+TEST_F(ContainersServiceTest, AddsStarterContainersOnce) {
+  std::vector<mojom::ContainerPtr> starters;
+  starters.push_back(MakeContainer("Personal"));
+  starters.push_back(MakeContainer("Work"));
+  CreateService(std::move(starters));
+
+  std::vector<mojom::ContainerPtr> containers = service_->GetContainers();
+  EXPECT_EQ((std::vector<std::string>{"Personal", "Work"}),
+            GetNames(containers));
+  for (const mojom::ContainerPtr& container : containers) {
+    EXPECT_TRUE(IsValidContainerId(container->id));
+  }
+
+  // Removing all containers must not bring the starters back.
+  for (const mojom::ContainerPtr& container : containers) {
+    EXPECT_FALSE(service_->RemoveContainer(container->id));
+  }
+  std::vector<mojom::ContainerPtr> starters_again;
+  starters_again.push_back(MakeContainer("Personal"));
+  CreateService(std::move(starters_again));
+  EXPECT_TRUE(service_->GetContainers().empty());
+}
+
+TEST_F(ContainersServiceTest, StarterContainersDontReplaceExistingOnes) {
+  std::vector<mojom::ContainerPtr> existing;
+  existing.push_back(MakeContainer("Existing", "existing-id"));
+  SetContainersToPrefs(existing, prefs_);
+
+  std::vector<mojom::ContainerPtr> starters;
+  starters.push_back(MakeContainer("Personal"));
+  CreateService(std::move(starters));
+
+  EXPECT_EQ((std::vector<std::string>{"Existing"}),
+            GetNames(service_->GetContainers()));
+}
+
+TEST_F(ContainersServiceTest, AddContainer) {
+  CreateService();
+
+  auto id = service_->AddContainer(MakeContainer("  Work  "));
+  ASSERT_TRUE(id.has_value());
+  EXPECT_TRUE(IsValidContainerId(id.value()));
+
+  mojom::ContainerPtr container = service_->GetContainer(id.value());
+  ASSERT_TRUE(container);
+  EXPECT_EQ("Work", container->name);
+
+  EXPECT_EQ(mojom::ContainerOperationError::kIdShouldBeEmpty,
+            service_->AddContainer(MakeContainer("Work", "some-id")).error());
+  EXPECT_EQ(mojom::ContainerOperationError::kInvalidName,
+            service_->AddContainer(MakeContainer(" \t ")).error());
+  EXPECT_EQ(1u, service_->GetContainers().size());
+}
+
+TEST_F(ContainersServiceTest, UpdateContainer) {
+  CreateService();
+  std::string id = AddContainers({"Work"})[0];
+
+  mojom::ContainerPtr update =
+      mojom::Container::New(id, "Office", mojom::Color::kOrange);
+  EXPECT_FALSE(service_->UpdateContainer(update.Clone()));
+  EXPECT_EQ(update, service_->GetContainer(id));
+
+  EXPECT_EQ(mojom::ContainerOperationError::kIdShouldBeSet,
+            service_->UpdateContainer(MakeContainer("Office")));
+  EXPECT_EQ(mojom::ContainerOperationError::kNotFound,
+            service_->UpdateContainer(MakeContainer("Office", "missing")));
+  EXPECT_EQ(mojom::ContainerOperationError::kInvalidName,
+            service_->UpdateContainer(MakeContainer("", id)));
+}
+
+TEST_F(ContainersServiceTest, RemoveContainer) {
+  CreateService();
+  std::vector<std::string> ids = AddContainers({"Work", "Personal"});
+
+  EXPECT_FALSE(service_->RemoveContainer(ids[0]));
+  EXPECT_FALSE(service_->GetContainer(ids[0]));
+  EXPECT_EQ((std::vector<std::string>{"Personal"}),
+            GetNames(service_->GetContainers()));
+
+  EXPECT_EQ(mojom::ContainerOperationError::kNotFound,
+            service_->RemoveContainer(ids[0]));
+  EXPECT_EQ(mojom::ContainerOperationError::kIdShouldBeSet,
+            service_->RemoveContainer(""));
+}
+
+TEST_F(ContainersServiceTest, MoveContainer) {
+  CreateService();
+  std::vector<std::string> ids = AddContainers({"A", "B", "C"});
+
+  EXPECT_FALSE(service_->MoveContainer(ids[0], 2));
+  EXPECT_EQ((std::vector<std::string>{"B", "C", "A"}),
+            GetNames(service_->GetContainers()));
+
+  EXPECT_FALSE(service_->MoveContainer(ids[2], 0));
+  EXPECT_EQ((std::vector<std::string>{"C", "B", "A"}),
+            GetNames(service_->GetContainers()));
+
+  EXPECT_EQ(mojom::ContainerOperationError::kInvalidIndex,
+            service_->MoveContainer(ids[0], 3));
+  EXPECT_EQ(mojom::ContainerOperationError::kNotFound,
+            service_->MoveContainer("missing", 0));
+}
+
+TEST_F(ContainersServiceTest, UsedContainersOutliveRemoval) {
+  CreateService();
+  std::string id = AddContainers({"Work"})[0];
+  EXPECT_TRUE(service_->GetUsedContainers().empty());
+
+  service_->MarkContainerUsed(*service_->GetContainer(id));
+  ASSERT_EQ(1u, service_->GetUsedContainers().size());
+
+  // Edits to a used container refresh its last-known details.
+  EXPECT_FALSE(service_->UpdateContainer(MakeContainer("Office", id)));
+  EXPECT_EQ("Office", service_->GetUsedContainers()[0]->name);
+
+  EXPECT_FALSE(service_->RemoveContainer(id));
+  std::vector<mojom::ContainerPtr> used = service_->GetUsedContainers();
+  ASSERT_EQ(1u, used.size());
+  EXPECT_EQ(id, used[0]->id);
+  EXPECT_EQ("Office", used[0]->name);
+
+  service_->ForgetUsedContainer(id);
+  EXPECT_TRUE(service_->GetUsedContainers().empty());
+}
+
+TEST_F(ContainersServiceTest, UnusedContainerEditsDontAddUsedRecord) {
+  CreateService();
+  std::string id = AddContainers({"Work"})[0];
+
+  EXPECT_FALSE(service_->UpdateContainer(MakeContainer("Office", id)));
+  EXPECT_TRUE(service_->GetUsedContainers().empty());
+}
+
+TEST_F(ContainersServiceTest, NotifiesObservers) {
+  CreateService();
+  TestObserver observer;
+  base::ScopedObservation<ContainersService, ContainersService::Observer>
+      observation(&observer);
+  observation.Observe(service_.get());
+
+  std::string id = AddContainers({"Work"})[0];
+  EXPECT_EQ(1, observer.change_count());
+
+  EXPECT_FALSE(service_->UpdateContainer(MakeContainer("Office", id)));
+  EXPECT_EQ(2, observer.change_count());
+
+  // Failed operations don't notify.
+  EXPECT_TRUE(service_->RemoveContainer("missing"));
+  EXPECT_EQ(2, observer.change_count());
+
+  // Neither does recording usage.
+  service_->MarkContainerUsed(*service_->GetContainer(id));
+  EXPECT_EQ(2, observer.change_count());
+
+  // Changes made directly to prefs (for example by sync) do.
+  prefs_.SetList(prefs::kContainersList, base::ListValue());
+  EXPECT_EQ(3, observer.change_count());
+}
+
+}  // namespace containers
