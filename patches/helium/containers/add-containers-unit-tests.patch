+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "components/containers/core/common/container_id.h"
+
+#include <string>
+
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace containers {
+
+TEST(ContainerIdTest, GeneratedIdsAreValidAndUnique) {
+  const std::string first = GenerateContainerId();
+  const std::string second = GenerateContainerId();
+
+  EXPECT_TRUE(IsValidContainerId(first));
+  EXPECT_TRUE(IsValidContainerId(second));
+  EXPECT_NE(first, second);
+}
+
+TEST(ContainerIdTest, IsValidContainerId) {
+  EXPECT_TRUE(IsValidContainerId("work"));
+  EXPECT_TRUE(IsValidContainerId("t-0123-abcd"));
+  EXPECT_TRUE(IsValidContainerId("ABC-123"));
+
+  EXPECT_FALSE(IsValidContainerId(""));
+  EXPECT_FALSE(IsValidContainerId("has space"));
+  EXPECT_FALSE(IsValidContainerId("under_score"));
+  EXPECT_FALSE(IsValidContainerId("../escape"));
+  EXPECT_FALSE(IsValidContainerId("caf\xC3\xA9"));
+  EXPECT_FALSE(IsValidContainerId(std::string(kMaxContainerIdLength + 1, 'a')));
+  EXPECT_TRUE(IsValidContainerId(std::string(kMaxContainerIdLength, 'a')));
+}
+
+}  // namespace containers
